<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="addCollectorTable" author="croz">
        <createSequence sequenceName="collector_id_seq" startValue="1" incrementBy="1"/>
        <createTable tableName="collector">
            <column name="id" type="BIGINT" defaultValueSequenceNext="collector_id_seq">
                <constraints primaryKey="true" primaryKeyName="PK_COLLECTOR"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="addStickerTable" author="croz">
        <createSequence sequenceName="sticker_id_seq" startValue="1" incrementBy="1"/>
        <createTable tableName="sticker">
            <column name="id" type="BIGINT" defaultValueSequenceNext="sticker_id_seq">
                <constraints primaryKey="true" primaryKeyName="PK_STICKER"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="latin_name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="description" type="VARCHAR(1020)">
                <constraints nullable="false" />
            </column>
            <column name="habitat" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="album" type="BIGINT"/>
            <column name="src" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="addAlbumTable" author="croz">
        <createSequence sequenceName="album_id_seq" startValue="1" incrementBy="1"/>
        <createTable tableName="album">
            <column name="id" type="BIGINT" defaultValueSequenceNext="album_id_seq">
                <constraints primaryKey="true" primaryKeyName="PK_ALBUM"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addForeignKeyConstraint  baseColumnNames="album"
                                  baseTableName="sticker"
                                  constraintName="fk_sticker_album_album"
                                  onDelete="CASCADE"
                                  onUpdate="RESTRICT"
                                  referencedColumnNames="id"
                                  referencedTableName="album"/>
    </changeSet>

    <changeSet id="addCollectedStickerTable" author="croz">
        <createSequence sequenceName="collector_sticker_id_seq" startValue="1" incrementBy="1"/>
        <createTable tableName="collector_stickers">
            <column name="sticker_id" type="BIGINT"/>
            <column name="collector_id" type="BIGINT"/>
            <column name="quantity" type="INT"/>
        </createTable>
        <addForeignKeyConstraint  baseColumnNames="sticker_id"
                                  baseTableName="collector_sticker"
                                  constraintName="fk_collector_sticker_sticker_id_sticker"
                                  onDelete="CASCADE"
                                  onUpdate="RESTRICT"
                                  referencedColumnNames="id"
                                  referencedTableName="sticker"/>
        <addForeignKeyConstraint  baseColumnNames="collector_id"
                                  baseTableName="collector_sticker"
                                  constraintName="fk_collector_sticker_collector_id_collector"
                                  onDelete="CASCADE"
                                  onUpdate="RESTRICT"
                                  referencedColumnNames="id"
                                  referencedTableName="collector"/>
    </changeSet>

</databaseChangeLog>
