<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="addNotificationTable" author="croz">
        <createSequence sequenceName="notification_id_seq" startValue="1" incrementBy="1"/>
        <createTable tableName="notification">
            <column name="id" type="BIGINT" defaultValueSequenceNext="notification_id_seq">
                <constraints primaryKey="true" primaryKeyName="pk_notification"/>
            </column>
            <column name="recipient_id" type="BIGINT"/>
            <column name="message" type="VARCHAR(255)"/>
            <column name="read" type="BOOLEAN"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint  baseColumnNames="recipient_id"
                                  baseTableName="notification"
                                  constraintName="fk_trade_offer_sender_id_collector"
                                  onDelete="CASCADE"
                                  onUpdate="RESTRICT"
                                  referencedColumnNames="id"
                                  referencedTableName="collector"/>
    </changeSet>

</databaseChangeLog>
